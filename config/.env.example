# 应用配置
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# 安全配置
JWT_SECRET_KEY=your_jwt_secret_key_here
API_KEYS=key1:user1,key2:user2
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
AMAP_ORIGIN=116.481485,39.990464  # 出发地坐标(经度,纬度)
AMAP_DESTINATION=116.481485,39.990464  # 目的地坐标(经度,纬度)
AMAP_STRATEGY=0  # 路线策略: 0-速度优先, 1-费用优先, 2-距离优先

# 钉钉机器人配置
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=***
DINGTALK_SECRET=your_dingtalk_secret_here
DINGTALK_KEYWORD=通勤提醒  # 消息关键词

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=True

# 定时任务配置
COMMUTE_CHECK_CRON=0 30 8 * * *  # 每天早上8:30执行 (秒 分 时 日 月 周)

# 第三方服务配置 (可选)
GITHUB_TOKEN=your_github_token_here
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
BRAVE_API_KEY=your_brave_api_key
NOTION_TOKEN=secret_your_notion_token
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}